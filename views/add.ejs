<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Student</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <style>
        html,
        body {
            height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
            background: #f4f7fc;
        }

        main {
            flex: 1;
        }

        .navbar {
            box-shadow: 0 3px 10px rgba(0, 0, 0, .2);
        }

        .card {
            border: none;
            border-radius: 15px;
            overflow: hidden;
        }

        .card-header {
            background: #198754;
            color: white;
            font-size: 30px;
            font-weight: bold;
            text-align: center;
        }

        .form-label {
            font-weight: 600;
        }

        .form-control {
            border-radius: 8px;
        }

        .form-control:focus {
            border-color: #198754;
            box-shadow: 0 0 8px rgba(25, 135, 84, .3);
        }

        .btn-success {
            border-radius: 8px;
            font-size: 18px;
        }

        footer {
            margin-top: auto;
        }
    </style>

</head>

<body>

    <!-- Navbar -->

    <nav class="navbar navbar-expand-lg navbar-dark bg-success">

        <div class="container">

            <a class="navbar-brand fw-bold" href="/students-list">

                <i class="bi bi-mortarboard-fill"></i>

                Student Management System

            </a>

            <a href="/students-list" class="btn btn-light">

                <i class="bi bi-arrow-left-circle-fill"></i>

                Student List

            </a>

        </div>

    </nav>

    <main>

        <div class="container py-5">

            <div class="row justify-content-center">

                <div class="col-lg-6">

                    <div class="card shadow-lg">

                        <div class="card-header">

                            <i class="bi bi-person-plus-fill"></i>

                            Add Student

                        </div>

                        <div class="card-body p-4">

                            <form id="studentForm">

                                <div class="mb-2">

                                    <label class="form-label">

                                        <i class="bi bi-person-fill text-primary"></i>

                                        Student Name

                                    </label>

                                    <input type="text" id="name" name="name" class="form-control"
                                        placeholder="Enter Student Name" required>

                                </div>
                                  <div class="mb-2">

                                    <label class="form-label">

                                      <i class="bi bi-envelope-fill text-primary"></i>
                                        Email

                                    </label>

                                    <input type="email" id="email" name="email" class="form-control"
                                        placeholder="Enter Student Email" required>

                                </div>

                                <div class="mb-2">

                                    <label class="form-label">

                                        <i class="bi bi-calendar-event text-success"></i>

                                        Age

                                    </label>

                                    <input type="number" id="age" name="age" class="form-control"
                                        placeholder="Enter Age" required>

                                </div>

                                <div class="mb-2">

                                    <label class="form-label">

                                        <i class="bi bi-geo-alt-fill text-danger"></i>

                                        City

                                    </label>

                                    <input type="text" id="city" name="city" class="form-control"
                                        placeholder="Enter City" required>

                                </div>
                                  <div class="mb-3">

                                    <label class="form-label">

                                        <i class="bi bi-book-fill text-primary"></i>
                                        Course

                                    </label>

                                    <input type="text" id="course" name="course" class="form-control"
                                        placeholder="Enter Student Course" required>

                                </div>

                                <div class="d-grid">

                                    <button class="btn btn-success btn-lg">

                                        <i class="bi bi-check-circle-fill"></i>

                                        Add Student

                                    </button>

                                </div>

                            </form>

                        </div>

                        <div class="card-footer text-center bg-light">

                            <a href="/students-list" class="btn btn-secondary">

                                <i class="bi bi-arrow-left-circle-fill"></i>

                                Back to Student List

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </main>

    <footer class="bg-dark text-white text-center py-3">

        <div class="container">

            © 2026 Student Management System |
            Express.js • MongoDB • Bootstrap 5

        </div>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
const form = document.getElementById("studentForm");

form.addEventListener("submit", async function (e) {

    e.preventDefault();

    const student = {
        name: document.getElementById("name").value.trim(),
        email: document.getElementById("email").value.trim(),
        age: document.getElementById("age").value.trim(),
        city: document.getElementById("city").value.trim(),
        course: document.getElementById("course").value.trim()
    };

    // Validation
    if (
        !student.name ||
        !student.email ||
        !student.age ||
        !student.city ||
        !student.course
    ) {

        Swal.fire({
            icon: "warning",
            title: "Validation Error",
            text: "Please fill all fields."
        });

        return;
    }

    try {

        const response = await fetch("/api/add-students", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(student)
        });

        const data = await response.json();

        if (!response.ok) {

            Swal.fire({
                icon: "error",
                title: "Failed",
                text: data.message || "Failed to add student."
            });

            return;
        }

        Swal.fire({
            icon: "success",
            title: "Student Added",
            text: data.message || "Student added successfully.",
            confirmButtonColor: "#198754"
        }).then(() => {

            form.reset();

            window.location.href = "/students-list";

        });

    } catch (err) {

        Swal.fire({
            icon: "error",
            title: "Server Error",
            text: err.message
        });

    }

});
</script>
</body>

</html>