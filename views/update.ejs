<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Student</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <style>
        html,
        body {
            height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
            background: #f4f7fc;
            overflow-x: hidden;
        }

        main {
            flex: 1;
        }

        .navbar {
            background: #6f42c1;
            box-shadow: 0 3px 10px rgba(0, 0, 0, .2);
        }

        .card {
            border: none;
            border-radius: 15px;
            overflow: hidden;
        }

        .card-header {
            background: #6f42c1;
            color: white;
            font-size: 30px;
            font-weight: bold;
            text-align: center;
            padding: 18px;
        }

        .form-label {
            font-weight: 600;
        }

        .form-control {
            border-radius: 8px;
        }

        .form-control:focus {
            border-color: #6f42c1;
            box-shadow: 0 0 8px rgba(111, 66, 193, .3);
        }

        .btn-update {
            background: #6f42c1;
            color: white;
            font-size: 18px;
            border-radius: 8px;
        }

        .btn-update:hover {
            background: #5a32a3;
            color: white;
        }

        footer {
            margin-top: auto;
            background: #6f42c1;
        }

        @media(max-width:768px) {

            .navbar .container {
                gap: 12px;
            }

            .navbar-brand {
                max-width: 100%;
                white-space: normal;
                line-height: 1.2;
            }

            .container.py-5 {
                padding-top: 28px !important;
                padding-bottom: 28px !important;
            }
        }

        @media(max-width:576px) {

            .container {
                padding-left: 16px;
                padding-right: 16px;
            }

            .navbar .container {
                align-items: stretch;
                flex-direction: column;
            }

            .navbar .btn {
                width: 100%;
            }

            .card {
                border-radius: 12px;
            }

            .card-header {
                font-size: 24px;
            }

            .card-body {
                padding: 22px 18px !important;
            }

            .card-footer .btn,
            .btn-update {
                width: 100%;
            }

            footer .container {
                font-size: 14px;
                line-height: 1.6;
            }
        }
    </style>

</head>

<body>

    <!-- Navbar -->

    <nav class="navbar navbar-expand-lg navbar-dark">

        <div class="container">

            <a class="navbar-brand fw-bold" href="/students-list">

                <i class="bi bi-mortarboard-fill"></i>

                Student Management System

            </a>

            <a href="/students-list" class="btn btn-light">

                <i class="bi bi-arrow-left-circle-fill"></i>

                Student List

            </a>

        </div>

    </nav>

    <main>

        <div class="container py-5">

            <div class="row justify-content-center">

                <div class="col-lg-6">

                    <div class="card shadow-lg">

                        <div class="card-header">

                            <i class="bi bi-pencil-square"></i>

                            Update Student

                        </div>

                        <div class="card-body p-4">

                            <form id="updateForm">
                                <div class="mb-2">

                                    <label class="form-label">

                                        <i class="bi bi-person-fill text-primary"></i>

                                        Student Name

                                    </label>

                                    <input type="text" id="name" name="name" class="form-control" required>

                                </div>
                                <div class="mb-2">

                                    <label class="form-label">

                                        <i class="bi bi-person-fill text-primary"></i>

                                        Email

                                    </label>

                                    <input type="email" id="email" name="email" class="form-control" required>

                                </div>

                                <div class="mb-2">

                                    <label class="form-label">

                                        <i class="bi bi-calendar-event text-success"></i>

                                        Age

                                    </label>

                                    <input type="number" id="age" name="age" class="form-control" required>

                                </div>

                                <div class="mb-2">

                                    <label class="form-label">

                                        <i class="bi bi-geo-alt-fill text-danger"></i>

                                        City

                                    </label>

                                    <input type="text" id="city" name="city" class="form-control" required>

                                </div>
                                <div class="mb-3">

                                    <label class="form-label">

                                        <i class="bi bi-person-fill text-primary"></i>

                                        Course

                                    </label>

                                    <input type="text" id="course" name="course" class="form-control" required>

                                </div>

                                <div class="d-grid">

                                    <button type="submit" class="btn btn-update btn-lg">

                                        <i class="bi bi-arrow-repeat"></i>

                                        Update Student

                                    </button>

                                </div>

                            </form>

                        </div>

                        <div class="card-footer text-center bg-light">

                            <a href="/students-list" class="btn btn-secondary">

                                <i class="bi bi-arrow-left-circle-fill"></i>

                                Back to Student List

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </main>

    <footer class="bg-dark text-white text-center py-3">

        <div class="container">

            &copy; 2026 Student Management System |
            Node.js &bull; Express.js &bull; MongoDB &bull; Mongoose &bull; EJS &bull; Bootstrap 5

        </div>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const id = window.location.pathname.split("/").pop();

        // Load Student
        async function loadStudent() {

            try {

                const response = await fetch(`/api/students/${id}`);

                if (!response.ok) {
                    throw new Error("Student not found");
                }

                const student = await response.json();

                document.getElementById("name").value = student.name;
                document.getElementById("email").value = student.email;
                document.getElementById("age").value = student.age;
                document.getElementById("city").value = student.city;
                document.getElementById("course").value = student.course;

            } catch (err) {

                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: err.message
                });

            }

        }

        loadStudent();


        // Update Student
        document.getElementById("updateForm").addEventListener("submit", async function (e) {

            e.preventDefault();

            const student = {

                name: document.getElementById("name").value.trim(),
                email: document.getElementById("email").value.trim(),
                age: document.getElementById("age").value.trim(),
                city: document.getElementById("city").value.trim(),
                course: document.getElementById("course").value.trim()

            };

            // Validation
            if (
                !student.name ||
                !student.email ||
                !student.age ||
                !student.city ||
                !student.course
            ) {

                Swal.fire({
                    icon: "warning",
                    title: "Validation Error",
                    text: "Please fill all fields."
                });

                return;
            }

            try {

                const response = await fetch(`/api/students/${id}`, {

                    method: "PUT",

                    headers: {
                        "Content-Type": "application/json"
                    },

                    body: JSON.stringify(student)

                });

                const data = await response.json();

                if (!response.ok) {

                    throw new Error(data.message || "Update Failed");

                }

                Swal.fire({
                    icon: "success",
                    title: "Updated!",
                    text: data.message || "Student updated successfully.",
                    confirmButtonColor: "#198754"
                }).then(() => {

                    window.location.href = "/students-list";

                });

            } catch (err) {

                Swal.fire({
                    icon: "error",
                    title: "Update Failed",
                    text: err.message
                });

            }

        });
    </script>
</body>

</html>
